# Запрет выполнения PHP скриптов в uploads
<FilesMatch "\.php$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# Разрешаем изображения и видео (все форматы)
<FilesMatch "\.(jpg|jpeg|png|gif|webp|svg|bmp|mp4|webm|ogg|ogv|mkv|avi|mov|wmv|flv|m4v|mpeg|mpg|3gp)$">
    Order Allow,Deny
    Allow from all
</FilesMatch>

php_flag engine off
